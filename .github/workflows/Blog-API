name: Deploy Client & Admin to GitHub Pages

on:
    push:
        branches: ["main"]
    workflow_dispatch:

permissions:
    contents: read
    pages: write
    id-token: write

concurrency:
    group: "pages"
    cancel-in-progress: true

jobs:
    deploy:
        runs-on: ubuntu-latest
        steps:
            # 1. Checkout repository 原始碼
            - name: Checkout repository
              uses: actions/checkout@v4

            # 2. 設定 Node.js 環境 (全域設定也可以)
            - name: Set up Node.js
              uses: actions/setup-node@v4
              with:
                  node-version: lts/*
                  cache: "npm"

            ############################
            # 建置 frontend-client
            ############################
            - name: Install dependencies for client
              run: npm ci
              working-directory: frontend-client

            - name: Build frontend-client
              run: npm run build
              working-directory: frontend-client

            ############################
            # 建置 frontend-admin
            ############################
            - name: Install dependencies for admin
              run: npm ci
              working-directory: frontend-admin

            - name: Build frontend-admin
              run: npm run build
              working-directory: frontend-admin

            #####################################
            # 整理產出結果到發佈用的資料夾 public
            #####################################
            - name: Prepare public folder
              run: |
                  mkdir -p public/client
                  mkdir -p public/admin
                  cp -r frontend-client/dist/* public/client/
                  cp -r frontend-admin/dist/* public/admin/

            ###################################
            # GitHub Pages 設定與部署流程
            ###################################
            - name: Setup GitHub Pages
              uses: actions/configure-pages@v5

            - name: Upload artifact
              uses: actions/upload-pages-artifact@v3
              with:
                  path: public

            - name: Deploy to GitHub Pages
              id: deployment
              uses: actions/deploy-pages@v4
